<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:gravity="center"
        android:weightSum="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shell"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            style="@style/Widget.Material3.Button.TextButton"
            app:iconTint="?attr/colorOnSurface"
            app:icon="@drawable/ic_shell"
            android:layout_weight="0.33"
            android:text="@string/shell"
            app:iconGravity="textStart"
            android:textStyle="bold"
            android:checkable="true"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/files"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            style="@style/Widget.Material3.Button.TextButton"
            app:iconTint="?attr/colorOnSurface"
            app:icon="@drawable/ic_folder"
            android:text="@string/files"
            android:layout_weight="0.34"
            app:iconGravity="textStart"
            android:textStyle="bold"
            android:checkable="true"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            style="@style/Widget.Material3.Button.TextButton"
            app:iconTint="?attr/colorOnSurface"
            app:icon="@drawable/ic_settings"
            android:text="@string/settings"
            android:layout_weight="0.33"
            app:iconGravity="textStart"
            android:textStyle="bold"
            android:checkable="true"
            app:iconSize="24dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- HIZLI WI-FI VE GLOBAL AYAR BUTONLARI -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_wifi_quick_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"
        android:orientation="vertical">

        <!-- 1. Satır: Wi-Fi Aç & Wi-Fi Kapat -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wifi_enable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"
                android:text="Wi-Fi Aç" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wifi_disable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:text="Wi-Fi Kapat" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 2. Satır: Global Aç & Tarama Aç -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wifi_global"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"
                android:text="Global Aç" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wifi_scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:text="Tarama Aç" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</androidx.appcompat.widget.LinearLayoutCompat>
